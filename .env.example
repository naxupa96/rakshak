# ==============================================================================
# RAKSHAK — Environment Configuration Template
# Copy this file to .env.local and populate the values if external LLM augmentation is desired.
# The core analytical and forensic verification pipeline functions 100% deterministically without keys.
# ==============================================================================

# LLM Augmentation Provider (Optional - Choose OpenAI or Anthropic)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# Generic OpenAI-Compatible Gateway (Optional)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Operational Port & Host
PORT=3000
HOST=0.0.0.0
